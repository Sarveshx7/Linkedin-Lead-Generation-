# Supabase PostgreSQL connection. Use the Supabase Session Pooler URI.
SUPABASE_DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_DRIVER=org.postgresql.Driver

# Optional public search providers. Configure at least one to collect leads.
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Optional Reddit collector credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=LeadDiscoverySystem/1.0 (Authorized lead ingest)

# Optional HTTP port and Hibernate schema setting.
PORT=8080
JPA_DDL_AUTO=update
APP_PORT=8085
